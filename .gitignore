# What must never reach GitHub. Nayive keeps secrets and personal data in the
# run-root (store/), so most of this file is about that folder.

# EVERYTHING in store/ is private - only the example config is versioned:
#   config/  server.json (admin name + password), vapid.json (Web Push private
#            key), shares.json (live public-share links), *.pem (TLS)
#   homes/   every user's data and documents (config.json holds their password)
#   data/ .thumbs/ .trash/   runtime state written by the server
/store/*
!/store/config/
/store/config/*
!/store/config/server.example.json

# The old run-root, before store/ (2026-09-15). Kept so a stray run with the old
# -config path can never get its secrets committed.
client/config/
client/homes/
client/data/
client/.thumbs/
client/.trash/

# The private VPS address deploy.sh reads (user, host, SSH port).
deploy.local.sh

# Design notes - kept local only. Some hold private data (the VPS login, the
# domain, real names, QR codes): scrub them before this line is ever removed.
/docs/

# VPS backup script + systemd units - kept local only.
/server/backup/

# Generated on every deploy / pack by tools/build-gzip - not source.
*.gz

# Write's docx-editor.dev engine IS tracked (Apache/MIT/OFL); only the previous
# build that tools/build-docx-editor.sh keeps for --restore is not.
client/apps/write/lib/.docx-editor-prev/

# The systemd unit install.sh writes: it holds this machine's user and paths.
/nayive.service

# Build output.
/nayive.zip
/server/go/nayive

# Snapshot folders made before edits.
.bak/

# Tool leftovers: npm and Python caches, and the page tools/locktest copies
# into client/apps/ for a run (left behind if the run is killed; deploy.sh
# would ship it).
node_modules/
__pycache__/
/client/apps/_locktest.html

# Claude Code local settings.
/.claude/

# Editor / OS cruft
*~
*.swp
*.swo
.DS_Store

# The Android app (android/): its private settings (where Nayive is served,
# where the signing key is) and everything Gradle builds. The keystore itself
# lives in store/config/, already ignored above.
/android/local.properties
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
