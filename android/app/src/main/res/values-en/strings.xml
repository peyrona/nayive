<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="setup_title">Welcome to Nayive</string>
    <string name="setup_lead">To work properly on this phone, Nayive needs a few permissions. You are only asked once.</string>
    <string name="step_notif_title">Notifications</string>
    <string name="step_notif_why">So calls ring and you see what is waiting for you.</string>
    <string name="step_loc_title">Location</string>
    <string name="step_loc_why">To keep where you go during your trips. Choose “Allow all the time”.</string>
    <string name="step_loc_bg">“Allow all the time” is missing: tap Allow and choose it on the screen that opens.</string>
    <string name="step_batt_title">Battery</string>
    <string name="step_batt_why">So Nayive stays awake with the screen off. Choose “Allow”.</string>
    <string name="step_full_title">Full screen</string>
    <string name="step_full_why">So a call shows even when the phone is locked.</string>
    <string name="step_media_title">Photos and videos</string>
    <string name="step_media_why">To upload the camera’s new photos to Nayive, if you turn it on in My account. It never deletes anything on the phone.</string>
    <string name="step_media_partial">You chose only some photos: tap Allow and choose “Allow all”.</string>
    <string name="step_do">Allow</string>
    <string name="step_ok">Done</string>
    <string name="setup_continue">Continue</string>
    <string name="setup_missing">Without every permission some things will not work. To come back here, long-press the Nayive icon.</string>
