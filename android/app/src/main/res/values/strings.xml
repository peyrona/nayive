    <string name="app_name">Nayive</string>

    <string name="setup_title">Bienvenido a Nayive</string>
    <string name="setup_lead">Para funcionar bien en este móvil, Nayive necesita unos permisos. Solo se piden una vez.</string>
    <string name="step_notif_title">Avisos</string>
    <string name="step_notif_why">Para que suenen las llamadas y veas lo que tienes pendiente.</string>
    <string name="step_loc_title">Ubicación</string>
    <string name="step_loc_why">Para guardar por dónde vas durante tus viajes. Elige «Permitir siempre».</string>
    <string name="step_loc_bg">Falta «Permitir siempre»: toca Permitir y elígelo en la pantalla que se abre.</string>
    <string name="step_batt_title">Batería</string>
    <string name="step_batt_why">Para que Nayive siga despierto con la pantalla apagada. Elige «Permitir».</string>
    <string name="step_full_title">Pantalla completa</string>
    <string name="step_full_why">Para que una llamada se vea aunque el móvil esté bloqueado.</string>
    <string name="step_media_title">Fotos y vídeos</string>
    <string name="step_media_why">Para subir a Nayive las fotos nuevas de la cámara, si lo activas en Mi cuenta. Nunca borra nada del móvil.</string>
    <string name="step_media_partial">Has elegido solo algunas fotos: toca Permitir y elige «Permitir todo».</string>
    <string name="step_do">Permitir</string>
    <string name="step_ok">Hecho</string>
    <string name="setup_continue">Continuar</string>
