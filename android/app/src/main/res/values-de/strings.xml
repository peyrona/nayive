<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="setup_title">Willkommen bei Nayive</string>
    <string name="setup_lead">Damit Nayive auf diesem Handy richtig funktioniert, braucht es ein paar Berechtigungen. Sie werden nur einmal gefragt.</string>
    <string name="step_notif_title">Benachrichtigungen</string>
    <string name="step_notif_why">Damit Anrufe klingeln und du siehst, was auf dich wartet.</string>
    <string name="step_loc_title">Standort</string>
    <string name="step_loc_why">Um während deiner Reisen festzuhalten, wo du bist. Wähle „Immer zulassen“.</string>
    <string name="step_loc_bg">„Immer zulassen“ fehlt: tippe auf Zulassen und wähle es auf dem nächsten Bildschirm.</string>
    <string name="step_batt_title">Akku</string>
    <string name="step_batt_why">Damit Nayive bei ausgeschaltetem Bildschirm wach bleibt. Wähle „Zulassen“.</string>
    <string name="step_full_title">Vollbild</string>
    <string name="step_full_why">Damit ein Anruf auch bei gesperrtem Handy erscheint.</string>
    <string name="step_media_title">Fotos und Videos</string>
    <string name="step_media_why">Um die neuen Fotos der Kamera zu Nayive hochzuladen, wenn du es in Mein Konto einschaltest. Auf dem Handy wird nie etwas gelöscht.</string>
    <string name="step_media_partial">Du hast nur einige Fotos gewählt: Tippe auf Zulassen und wähle „Alle zulassen“.</string>
    <string name="step_do">Zulassen</string>
    <string name="step_ok">Erledigt</string>
    <string name="setup_continue">Weiter</string>
    <string name="setup_missing">Ohne alle Berechtigungen funktionieren manche Dinge nicht. Um hierher zurückzukommen, halte das Nayive-Symbol gedrückt.</string>
